{
  "name": "av1opt-desktop",
  "productName": "av1opt",
  "version": "0.1.0",
  "description": "Desktop window for av1opt ui (bundled Chromium, so AV1 always plays)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "postinstall": "node node_modules/electron/install.js",
    "dist": "electron-builder --linux deb",
    "install-desktop": "sh install-desktop.sh",
    "dist:appimage": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "author": "Cotions",
  "license": "MIT",
  "homepage": "https://github.com/Cotions/av1opt",
  "build": {
    "appId": "local.av1opt.desktop",
    "productName": "av1opt",
    "afterPack": "./after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../target/release/av1opt",
        "to": "av1opt"
      }
    ],
    "linux": {
      "target": "deb",
      "category": "AudioVideo;Video",
      "executableName": "av1opt-desktop",
      "icon": "icon.png",
      "syncDesktopName": true,
      "maintainer": "Cotions",
      "description": "Shrink videos to AV1 at a target quality"
    },
    "directories": {
      "output": "dist"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "electronLanguages": [
      "en-US"
    ],
    "deb": {
      "packageName": "av1opt-desktop"
    }
  },
  "desktopName": "av1opt.desktop"
}
